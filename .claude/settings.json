{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/md-writing-skill.sh",
            "timeout": 10,
            "statusMessage": "Checking Markdown edit"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fidelity-guard.sh",
            "timeout": 15,
            "statusMessage": "Fidelity guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-hint.sh",
            "timeout": 5,
            "statusMessage": "Skill hint"
          }
        ]
      }
    ]
  }
}
