# Written by `pnpm bootstrap`: the dev server's port, checked free on this
# machine at the time. Never commit .env.
PORT=

# The gate for the deployed prototypes (proxy.ts). Each person signs in with
# their own one-time link; this secret signs their session cookie. Set it in the
# Vercel project's Environment Variables for Production and Preview; `pnpm
# bootstrap --vercel <project>` does it. Never commit it, never send it.
# GATE_SECRET: 32+ random bytes, base64 or hex (openssl rand -base64 32).
# Replacing it signs everyone out.
GATE_SECRET=

# Optional: TypeSafe's Jev checks (the fidelity guard, the pre-flight, comment
# triage, the skill hint). Set by `pnpm bootstrap --typesafe-key <key>`. Only this
# file turns it on, never a key in the shell. Absent, every Jev question is skipped.
TYPESAFE_API_KEY=

# Optional: the review store (comments and people) on the deployed site.
# `pnpm bootstrap --vercel <project> --review` adds Upstash Redis through the
# Vercel Marketplace and copies these two here, so `pnpm comments` and
# `pnpm people` reach the same store. Absent, they use the local dev store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: `pnpm fixtures-pull` reads real content from the website's CMS.
# Fill only the platform's lines. Read-only access is enough.
# Webflow: a site token with the cms:read scope.
WEBFLOW_TOKEN=
# Payload: the site's origin and an API key from a user in an auth collection
# with useAPIKey on (PAYLOAD_AUTH_COLLECTION when that collection is not users).
PAYLOAD_URL=
PAYLOAD_API_KEY=
PAYLOAD_AUTH_COLLECTION=
# WordPress: the site's origin. Drafts need a user and an application password.
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# Design Hub upgrades itself when a Claude Code session starts. 0 turns that off.
# DESIGN_HUB_AUTO_UPDATE=0
