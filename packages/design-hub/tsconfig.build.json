{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "vite/**/*.ts", "vercel/**/*.ts"],
  "exclude": ["**/*.test.ts", "vite/config.legacy.ts"]
}
