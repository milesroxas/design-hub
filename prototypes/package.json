{
  "name": "design-hub-prototypes",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "bootstrap": "node _scripts/bootstrap.ts",
    "commands": "node _scripts/commands.ts",
    "dev": "vite",
    "new": "node _scripts/new.ts",
    "new:guide": "node _scripts/new.ts --guide",
    "check": "tsc --noEmit && biome check . ../setup",
    "fix": "biome check --write . ../setup",
    "test": "node --test \"_core/**/*.test.ts\" \"_server/**/*.test.ts\" \"_scripts/**/*.test.ts\" \"*.test.ts\" \"../setup/*.test.mjs\"",
    "guard": "node _scripts/guard.ts",
    "preflight": "node _scripts/preflight.ts",
    "people": "node _scripts/people.ts",
    "comments": "node _scripts/comments.ts",
    "calibrate": "node _scripts/calibrate.ts",
    "fixtures:pull": "node _scripts/fixtures-pull.ts",
    "visual-match": "node _scripts/visual-match.ts",
    "elyx": "node _scripts/elyx.ts",
    "skill-hint": "node _scripts/skill-hint.ts",
    "release-check": "node _scripts/release-check.ts",
    "build": "vite build",
    "preview": "vite preview",
    "quality": "rm -rf ../.design-hub/coverage && NODE_V8_COVERAGE=../.design-hub/coverage pnpm run --silent test > /dev/null && npx -y fallow@3.38.0 --coverage ../.design-hub/coverage && cd ../setup && npx -y fallow@3.38.0 --coverage ../.design-hub/coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vercel/functions": "^3.10.4",
    "dialkit": "^2.1.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "@aiforui/lapse": "^0.19.0"
  }
}
